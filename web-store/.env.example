# ==============================================================================
# WhiteLabelCommerce Web Store — Environment Variables Example
# Copy this file to `.env.local` and fill in your real project credentials.
# NEVER commit `.env.local` or any real secret keys to Git.
# ==============================================================================

# Supabase Project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon Key (public, subject to RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_replace_with_your_anon_key

# Supabase Service Role / Secret Key (SERVER-ONLY — NEVER expose to browser)
# Required by Admin Panel server actions & Paymob payment routes (/api/payments/paymob/*)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_with_your_service_role_key

# Note on Paymob Credentials:
# Paymob API Key, HMAC Secret, and Integration/iFrame IDs are stored per-tenant
# in Supabase (`store_payment_secrets`, service_role-only) via Admin -> Settings -> Payments.

# ==============================================================================
# Firebase Cloud Messaging (FCM HTTP v1 + Web Push) — Phase 9 Smart Notifications
# Keep service account credentials SERVER-ONLY. NEVER commit real values to Git.
# ==============================================================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_SERVICE_ACCOUNT_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Optional Web Push (Firebase Web SDK / VAPID public key — safe for browser)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional Cron Secret for /api/notifications/cron/recovery (Abandoned Cart & Unpaid Order Recovery)
CRON_SECRET=replace_with_random_cron_secret
