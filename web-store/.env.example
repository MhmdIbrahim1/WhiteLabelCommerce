# ==============================================================================
# WhiteLabelCommerce Web Store — Environment Variables Example
# Copy this file to `.env.local` and fill in your real project credentials.
# NEVER commit `.env.local` or any real secret keys to Git.
# ==============================================================================

# Supabase Project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon Key (public, subject to RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_replace_with_your_anon_key

# Supabase Service Role / Secret Key (SERVER-ONLY — NEVER expose to browser)
# Required by Admin Panel server actions & Paymob payment routes (/api/payments/paymob/*)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_with_your_service_role_key

# Note on Paymob Credentials:
# Paymob API Key, HMAC Secret, and Integration/iFrame IDs are stored per-tenant
# in Supabase (`store_payment_secrets`, service_role-only) via Admin -> Settings -> Payments.
