<?xml version="1.0" encoding="utf-8"?>
<!-- Google Play flavor: strictly HTTPS-only (zero cleartext traffic permitted). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
